{
  "npm": {
    "publish": false
  },
  "github": {
    "release": true
  },
  "git": {
    "tagName": "v${version}",
    "commitMessage": "chore(release): v${version}",
    "requireCleanWorkingDir": true,
    "addUntrackedFiles": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.project.md",
      "header": "# 변경 이력\n\n",
      "gitRawCommitsOpts": {
        "firstParent": true
      },
      "commitsOpts": {
        "firstParent": true
      }
    }
  }
}
